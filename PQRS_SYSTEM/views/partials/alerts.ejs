<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
<% } %>

<% if (typeof errors !== 'undefined' && errors && errors.length) { %>
  <div class="alert alert-error">
    <strong>Corrija lo siguiente:</strong>
    <ul>
      <% errors.forEach(function(error) { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>